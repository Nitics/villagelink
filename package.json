  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "playwright": "^1.56.0",
    "typescript": "5.6.3",
    "vite": "5.4.20",
    "vitest": "2.1.8"
  }
}
